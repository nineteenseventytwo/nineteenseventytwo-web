{
  "name": "nineteenseventytwo-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:inline": "node scripts/check-no-inline.mjs dist",
    "test": "node --test 'events/test/*.test.mjs' && astro check && astro build && node scripts/check-no-inline.mjs dist",
    "test:events": "node --test 'events/test/*.test.mjs'",
    "events": "node events/src/run.mjs --out build/events.json"
  },
  "dependencies": {
    "astro": "7.4.0",
    "cheerio": "1.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}

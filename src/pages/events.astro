---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

// "Coming up" is built in the browser from /events.json, which the weekly
// gig job writes to the bucket (plan 09, F7) - so the list refreshes without
// a site rebuild. The script is a file (public/js/gigs.js), not inline: the
// CSP allows script-src 'self' only.
//
// "Been there" is static, from the gigs content collection.
const attended = await Promise.all(
  (await getCollection('gigs'))
    .sort((a, b) => b.data.date.localeCompare(a.data.date))
    .map(async (gig) => ({ gig, Content: (await render(gig)).Content })),
);

const fmt = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', {
    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  });
---

<Base title="Gigs" description="Live music near me, refreshed weekly - and the ones I've been to.">
  <h1>Gigs</h1>

  <section aria-labelledby="coming-up">
    <h2 id="coming-up">Coming up</h2>
    <p id="gigs-status" class="gigs__status">Loading the gig list…</p>
    <div id="gigs" data-src="/events.json"></div>
    <noscript>
      <p>The gig list loads with JavaScript. The raw data is at <a href="/events.json">/events.json</a>.</p>
    </noscript>
  </section>

  <hr class="rainbow" />

  <section aria-labelledby="been-there">
    <h2 id="been-there">Been there</h2>
    {attended.length === 0 && <p>Nothing logged yet.</p>}
    {attended.map(({ gig, Content }) => (
      <article class="entry">
        <h3>{gig.data.title}</h3>
        <p class="gig__meta">{fmt(gig.data.date)}{gig.data.venue && ` · ${gig.data.venue}`}</p>
        {gig.data.photo && (
          <figure>
            <Image
              src={gig.data.photo}
              alt={gig.data.photoAlt ?? ''}
              widths={[480, 800]}
              sizes="(max-width: 46rem) 100vw, 46rem"
            />
          </figure>
        )}
        <Content />
      </article>
    ))}
  </section>

  <script type="module" src="/js/gigs.js" is:inline></script>
</Base>
